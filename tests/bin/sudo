#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/_mock.bash"
log_command "$YAMS_SUDO_LOG" sudo "$@"

if [[ "${1:-}" == -n ]]; then
    exec /usr/bin/sudo "$@"
fi

if [[ "${1:-}" == -u ]]; then
    shift 2
    exec "$@"
fi

case "${1:-}" in
    apt)
        case "${2:-}" in
            update) exit "${YAMS_SUDO_APT_UPDATE_STATUS:-0}" ;;
            install) exit "${YAMS_SUDO_APT_INSTALL_STATUS:-0}" ;;
        esac
        ;;
    chown|usermod)
        exit 0
        ;;
    cp|mv)
        if [[ "${3:-}" == /usr/local/bin/yams ]]; then
            "$1" "$2" "$YAMS_SYSTEM_BIN/yams"
            exit 0
        fi
        ;;
    chmod)
        if [[ "${3:-}" == /usr/local/bin/yams ]]; then
            chmod "$2" "$YAMS_SYSTEM_BIN/yams"
            exit 0
        fi
        ;;
    install)
        source_file=${@: -2:1}
        destination=${@: -1}
        [[ "$destination" == /usr/local/bin/yams ]] && destination="$YAMS_SYSTEM_BIN/yams"
        [[ "$destination" == /usr/local/bin ]] && destination="$YAMS_SYSTEM_BIN/yams"
        install -m 0755 "$source_file" "$destination"
        exit 0
        ;;
esac

exec /usr/bin/sudo "$@"
